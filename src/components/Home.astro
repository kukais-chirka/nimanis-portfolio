            });
          },
          { threshold: 0.18, rootMargin: "0px 0px -8% 0px" }
        );
        targets.forEach((el) => io.observe(el));
      }

      // Lead form: validation, loading, success and error states.
      const form = document.getElementById("lead-form");
      if (form) {
        const status = form.querySelector("[data-status]");
        const submit = form.querySelector("[data-submit]");
        const label = form.querySelector("[data-label]");
        // Strings come from the rendered markup so the script stays language agnostic.
        const copy = form.dataset;

        const validate = (el) => {
          const field = el.closest(".field");
          const err = form.querySelector(`[data-err-for="${el.id}"]`);
          const ok = el.checkValidity() && el.value.trim().length > 0;
          field.toggleAttribute("data-invalid", !ok);
          err.hidden = ok;
          el.setAttribute("aria-invalid", String(!ok));
          return ok;
        };

        form.querySelectorAll(".field input, .field textarea").forEach((el) => {
          el.addEventListener("blur", () => validate(el));
          el.addEventListener("input", () => {
            if (el.closest(".field").hasAttribute("data-invalid")) validate(el);
          });
        });

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const fields = [...form.querySelectorAll(".field input, .field textarea")];
          const valid = fields.map(validate).every(Boolean);

          if (!valid) {
            status.hidden = false;
            status.removeAttribute("data-tone");
            status.textContent = copy.msgInvalid;
            fields.find((el) => el.closest(".field").hasAttribute("data-invalid"))?.focus();
            return;
          }

          submit.disabled = true;
          label.textContent = copy.labelSending;
          status.hidden = true;

          try {
            // Netlify Forms: POST url-encoded back to the page itself. The
            // form-name hidden field tells Netlify which form this is.
            const res = await fetch(location.pathname, {
              method: "POST",
              headers: { "Content-Type": "application/x-www-form-urlencoded" },
              body: new URLSearchParams(new FormData(form)),
            });
            if (!res.ok) throw new Error("Request failed");

            form.reset();
            status.hidden = false;
            status.setAttribute("data-tone", "ok");
            status.textContent = copy.msgOk;
          } catch {
            status.hidden = false;
            status.removeAttribute("data-tone");
            status.textContent = copy.msgFail;
          } finally {
            submit.disabled = false;
            label.textContent = copy.labelIdle;
          }
        });
      }
    </script>
  </body>
</html>
