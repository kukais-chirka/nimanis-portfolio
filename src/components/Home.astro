---
// Portfolio page: website developer for service businesses.
// Dials: DESIGN_VARIANCE 7 / MOTION_INTENSITY 5 / VISUAL_DENSITY 3
// Theme: light-first. Follows prefers-color-scheme, with a manual toggle that persists.
// Accent: single terracotta (#C2451F light / #FF7A4D dark) used page-wide.
// Radius: one system, 14px everywhere. Buttons, cards, media, inputs.
// Font: Outfit, self-hosted via @fontsource-variable (no external font request).
// TODO before production: swap picsum.photos seeds for real client photography.

import "@fontsource-variable/outfit";
// Inlined so the wordmark inherits currentColor and works in both themes.
import chiiWordmark from "../../public/brand/chii-wordmark.svg?raw";
import {
  content,
  clients,
  workAssets,
  statValues,
  offerPrice,
  offerPriceWas,
  localeMeta,
  EMAIL,
  SITE,
  WORDMARK,
  GA_ID,
  type Locale,
} from "../i18n/content";

// Analytics only loads on the real domain, so local dev and Netlify deploy
// previews never pollute the GA property with fake traffic.
const analyticsEnabled = import.meta.env.PROD;

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = content[lang];
const other: Locale = lang === "lv" ? "en" : "lv";

const work = workAssets.map((w, i) => ({ ...w, ...t.work.items[i] }));
---

<html lang={localeMeta[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={`${SITE}${localeMeta[lang].path}`} />
    <link rel="alternate" hreflang="lv" href={`${SITE}/`} />
    <link rel="alternate" hreflang="en" href={`${SITE}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F4F4F5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121214" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Applied before paint so a stored override never flashes the wrong theme.
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.setAttribute("data-theme", saved);
          }
        } catch (e) {}
      })();
    </script>
    <link rel="preload" as="image" href="/images/nimanis-portrait.webp" />

    {/* No analytics tag here on purpose. GA is injected only after consent. */}
  </head>

  <body>
    <a class="skip" href="#main">{t.skip}</a>

    <!-- Header: one line at desktop, 68px tall -->
    <header class="site-head">
      <div class="shell head-inner">
        <a class="wordmark" href={localeMeta[lang].path} aria-label={WORDMARK}>
          <span class="wordmark-art" set:html={chiiWordmark} />
        </a>
        <nav class="head-nav" aria-label={t.nav.label}>
          <a href="#services">{t.nav.services}</a>
          <a href="#offer">{t.nav.offer}</a>
          <a href="#work">{t.nav.work}</a>
          <a href="#process">{t.nav.process}</a>
          <a href="#faq">{t.nav.faq}</a>
        </nav>
        <a class="lang-switch" href={localeMeta[other].path} hreflang={other} lang={other}>
          <span class="sr-only">{t.lang.label}: </span>{localeMeta[other].label}
        </a>
        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          aria-pressed="false"
          data-to-dark={t.theme.toDark}
          data-to-light={t.theme.toLight}
        >
          <span class="sr-only">{t.theme.before}</span><span data-theme-label>{t.theme.toDark}</span
          ><span class="sr-only">{t.theme.after}</span>
        </button>
        <a class="btn btn-primary btn-sm" href="#contact" data-cta="nav">{t.cta.primary}</a>
      </div>
    </header>

    <main id="main">
      <!-- 1. HERO. Layout family: asymmetric split -->
      <section class="hero">
        <div class="shell hero-grid">
          <div class="hero-copy" data-enter>
            <h1>
              {t.hero.headlineA}<br />
              {t.hero.headlineB}
            </h1>
            <p class="lede">{t.hero.lede}</p>
            <div class="hero-cta">
              <a class="btn btn-primary" href="#contact" data-cta="hero">{t.cta.primary}</a>
              <a class="btn btn-ghost" href="#work">{t.cta.secondary}</a>
            </div>
          </div>
          <div class="hero-media" data-enter data-enter-delay="1">
            <img
              src="/images/nimanis-portrait.webp"
              alt={t.hero.portraitAlt}
              width="900"
              height="904"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <!-- 2. TRUST. Layout family: logo wall -->
      <section class="proof" aria-labelledby="proof-h">
        <div class="shell">
          <h2 id="proof-h" class="proof-h">{t.proof.heading}</h2>
          <ul class="logo-wall">
            {
              clients.map((c) => (
                <li>
                  <a href={c.href} rel="noopener">
                    <span
                      class="logo-art logo-mask"
                      role="img"
                      aria-label={c.name}
                      style={`--mask:url('${c.mask}');--logo-w:${c.width};--logo-ar:${c.ratio}`}
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- 3. STATEMENT. Layout family: offset editorial single column -->
      <section class="statement">
        <div class="shell">
          <div class="statement-inner" data-reveal>
            <h2>{t.statement.heading}</h2>
            <p>{t.statement.body}</p>
          </div>
        </div>
      </section>

      <!-- 4. OFFER. Layout family: contained accent panel, centre-aligned.
           The only centred block on the page, so it reads as the conversion moment. -->
      <section class="offer" id="offer" aria-labelledby="offer-h">
        <div class="shell">
          <div class="offer-panel" data-reveal>
            <h2 id="offer-h">{t.offer.heading}</h2>
            <p class="offer-body">{t.offer.body}</p>
            <p class="offer-price">
              <s class="offer-was">
                <span class="sr-only">{t.offer.wasLabel}: </span>{offerPriceWas}
              </s>
              <span class="offer-now">
                <span class="sr-only">{t.offer.nowLabel}: </span>{offerPrice}
              </span>
            </p>
            <ul class="offer-list">
              {t.offer.list.map((item) => <li>{item}</li>)}
            </ul>
            <a class="btn btn-oncolor" href="#contact" data-cta="offer">{t.cta.primary}</a>
          </div>
        </div>
      </section>

      <!-- 5. SERVICES. Layout family: asymmetric bento, exactly 4 cells -->
      <section class="services" id="services" aria-labelledby="services-h">
        <div class="shell">
          <h2 id="services-h" class="sec-h">{t.services.heading}</h2>
          <div class="bento">
            <article class="cell cell-wide" data-reveal>
              <h3>{t.services.cells[0].title}</h3>
              <p>{t.services.cells[0].body}</p>
            </article>

            <article class="cell cell-media" data-reveal data-reveal-delay="1">
              <img
                src="https://picsum.photos/seed/search-results-on-phone-outdoors/900/700"
                alt={t.services.mediaAlt}
                loading="lazy"
                width="900"
                height="700"
                decoding="async"
              />
              <div class="cell-body">
                <h3>{t.services.cells[1].title}</h3>
                <p>{t.services.cells[1].body}</p>
              </div>
            </article>

            <article class="cell" data-reveal>
              <h3>{t.services.cells[2].title}</h3>
              <p>{t.services.cells[2].body}</p>
            </article>

            <article class="cell" data-reveal>
              <h3>{t.services.cells[3].title}</h3>
              <p>{t.services.cells[3].body}</p>
            </article>

            <article class="cell cell-tint cell-wide" data-reveal data-reveal-delay="1">
              <h3>{t.services.cells[4].title}</h3>
              <p>{t.services.cells[4].body}</p>
            </article>
          </div>
        </div>
      </section>


      <!-- 6. WORK. Layout family: staggered offset gallery -->
      <section class="work" id="work" aria-labelledby="work-h">
        <div class="shell">
          <h2 id="work-h" class="sec-h">{t.work.heading}</h2>
          <div class="work-stagger">
            {
              work.map((w, i) => (
                <article class={`piece piece-${i}`} data-reveal>
                  <div class="piece-media" style={`aspect-ratio:${w.ratio}`}>
                    <img
                      src={w.img}
                      alt={w.alt ?? `${w.client}, ${w.sector}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="piece-meta">
                    <h3>
                      <a href={w.href} rel="noopener">
                        {w.client}
                      </a>
                    </h3>
                    <p class="piece-sector">{w.sector}</p>
                    <p class="piece-line">{w.line}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 6. RESULTS. Layout family: full-bleed tinted stat band -->
      <!-- Figures supplied by the business owner. Keep the evidence for the first two
           on file, and only name a client once that client has confirmed it. -->
      <section class="results" aria-labelledby="results-h">
        <div class="shell">
          <h2 id="results-h" class="sr-only">{t.results.srHeading}</h2>
          <dl class="stat-band">
            {
              statValues.map((value, i) => (
                <div
                  class={i === 0 ? "stat stat-lg" : "stat"}
                  data-reveal
                  data-reveal-delay={i > 0 ? String(i) : undefined}
                >
                  <dt>{value}</dt>
                  <dd>{t.results.labels[i]}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- 7. PROCESS. Layout family: vertical rail with sticky heading -->
      <section class="process" id="process" aria-labelledby="process-h">
        <div class="shell process-grid">
          <div class="process-head">
            <h2 id="process-h" class="sec-h">{t.process.heading}</h2>
            <p>{t.process.note}</p>
          </div>
          <ol class="rail">
            {
              t.process.steps.map((s) => (
                <li data-reveal>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- 8. TESTIMONIALS. Layout family: offset quote and portrait pair -->
      <!-- Names and companies are real. The quote wording below is still a DRAFT written
           for them, not their own words. Get both quotes approved in writing by Laura and
           Marta before this page goes live, and swap in whatever they actually say. -->
      <section class="voices" aria-labelledby="voices-h">
        <div class="shell">
          <h2 id="voices-h" class="sec-h">{t.voices.heading}</h2>
          <div class="voice-pair">
            {
              t.voices.quotes.map((v, i) => (
                <figure
                  class={i === 0 ? "voice" : "voice voice-offset"}
                  data-reveal
                  data-reveal-delay={i > 0 ? "1" : undefined}
                >
                  <blockquote set:html={v.quote} />
                  <figcaption>
                    <span>
                      <strong>{v.name}</strong>
                      {v.role}
                    </span>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 9. FAQ. Layout family: disclosure accordion -->
      <section class="faq" id="faq" aria-labelledby="faq-h">
        <div class="shell faq-grid">
          <h2 id="faq-h" class="sec-h">{t.faq.heading}</h2>
          <div class="faq-list">
            {
              t.faq.items.map((f) => (
                <details data-reveal>
                  <summary>
                    <span>{f.q}</span>
                    <i class="plus" aria-hidden="true" />
                  </summary>
                  <p>{f.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 10. CONTACT. Layout family: split form -->
      <section class="contact" id="contact" aria-labelledby="contact-h">
        <div class="shell contact-grid">
          <div class="contact-copy" data-reveal>
            <h2 id="contact-h">{t.contact.heading}</h2>
            <p>{t.contact.body}</p>
            <p class="contact-direct">
              {t.contact.directPrefix} <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
            </p>
          </div>

          <form
            class="form"
            id="lead-form"
            name="lead"
            method="POST"
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            novalidate
            data-reveal
            data-reveal-delay="1"
            data-label-idle={t.cta.primary}
            data-label-sending={t.contact.form.sending}
            data-msg-invalid={t.contact.form.invalid}
            data-msg-ok={t.contact.form.ok}
            data-msg-fail={t.contact.form.fail}
          >
            {/* Netlify needs form-name in the POST body to route the submission. */}
            <input type="hidden" name="form-name" value="lead" />
            {/* Bot trap. Real people never see it, so anything in it is spam. */}
            <p class="hp" aria-hidden="true">
              <label>Do not fill this in <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>

            <div class="field">
              <label for="f-name">{t.contact.form.name}</label>
              <input id="f-name" name="name" type="text" autocomplete="name" required />
              <p class="err" data-err-for="f-name" hidden>{t.contact.form.errName}</p>
            </div>

            <div class="field">
              <label for="f-business">{t.contact.form.business}</label>
              <input id="f-business" name="business" type="text" autocomplete="organization" required />
              <p class="hint">{t.contact.form.businessHint}</p>
              <p class="err" data-err-for="f-business" hidden>{t.contact.form.errBusiness}</p>
            </div>

            <div class="field">
              <label for="f-email">{t.contact.form.email}</label>
              <input id="f-email" name="email" type="email" autocomplete="email" required />
              <p class="err" data-err-for="f-email" hidden>{t.contact.form.errEmail}</p>
            </div>

            <div class="field">
              <label for="f-brief">{t.contact.form.brief}</label>
              <textarea id="f-brief" name="brief" rows="4" required></textarea>
              <p class="hint">{t.contact.form.briefHint}</p>
              <p class="err" data-err-for="f-brief" hidden>{t.contact.form.errBrief}</p>
            </div>

            <button class="btn btn-primary btn-block" type="submit" data-submit>
              <span data-label>{t.cta.primary}</span>
            </button>

            <p class="form-status" data-status role="status" aria-live="polite" hidden></p>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-foot">
      <div class="shell foot-inner">
        <a class="wordmark" href={localeMeta[lang].path}>{t.brandFull}</a>
        <nav class="foot-nav" aria-label={t.nav.footerLabel}>
          <a href="#services">{t.nav.services}</a>
          <a href="#offer">{t.nav.offer}</a>
          <a href="#work">{t.nav.work}</a>
          <a href="#process">{t.nav.process}</a>
          <a href="#faq">{t.nav.faq}</a>
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <a href={localeMeta[other].path} hreflang={other} lang={other}>{t.lang.switchTo}</a>
          <button class="foot-link" type="button" data-consent-reopen>{t.consent.manage}</button>
        </nav>
        <p class="foot-note">{t.footer.note}</p>
      </div>
    </footer>

    <!-- Consent banner. Hidden until the script decides it is needed, so a
         returning visitor who already chose never sees it flash. -->
    <section class="consent" role="region" aria-label={t.consent.label} data-consent hidden>
      <div class="shell consent-inner">
        <p>{t.consent.text}</p>
        <div class="consent-actions">
          <button class="btn btn-ghost btn-sm" type="button" data-consent-reject>
            {t.consent.reject}
          </button>
          <button class="btn btn-primary btn-sm" type="button" data-consent-accept>
            {t.consent.accept}
          </button>
        </div>
      </div>
    </section>

    <style is:global>
      /* ---------- tokens ---------- */
      :root {
        --bg: #f4f4f5;
        --surface: #fcfcfd;
        --tint: #f6ece8;
        --ink: #18181b;
        --ink-soft: #52525b;
        --line: #e0e0e3;
        --accent: #c2451f;
        --accent-ink: #ffffff;
        --r: 14px; /* single radius system, page-wide */
        --shell: 1240px;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* Dark tokens apply when the system asks for them, unless the user pinned light. */
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --bg: #121214;
          --surface: #1a1a1d;
          --tint: #241a16;
          --ink: #f4f4f5;
          --ink-soft: #a1a1aa;
          --line: #2d2d31;
          --accent: #ff7a4d;
          --accent-ink: #1a1a1d;
        }
      }

      /* ...or when the user pins dark explicitly. */
      :root[data-theme="dark"] {
        --bg: #121214;
        --surface: #1a1a1d;
        --tint: #241a16;
        --ink: #f4f4f5;
        --ink-soft: #a1a1aa;
        --line: #2d2d31;
        --accent: #ff7a4d;
        --accent-ink: #1a1a1d;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Outfit Variable", ui-sans-serif, system-ui, sans-serif;
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      img {
        display: block;
        max-width: 100%;
        height: auto;
      }

      a {
        color: inherit;
      }

      h1,
      h2,
      h3 {
        margin: 0;
        letter-spacing: -0.03em;
        line-height: 1.08;
        font-weight: 600;
      }

      p {
        margin: 0;
      }

      .shell {
        width: 100%;
        max-width: var(--shell);
        margin-inline: auto;
        padding-inline: 20px;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--accent);
        color: var(--accent-ink);
        padding: 12px 18px;
        border-radius: var(--r);
      }
      .skip:focus {
        left: 12px;
        top: 12px;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        border-radius: 4px;
      }

      /* ---------- buttons ---------- */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        gap: 8px;
        padding: 14px 24px;
        border-radius: var(--r);
        border: 1px solid transparent;
        font: inherit;
        font-weight: 600;
        font-size: 16px;
        line-height: 1;
        text-decoration: none;
        cursor: pointer;
        transition:
          transform 0.18s var(--ease),
          background-color 0.18s var(--ease),
          border-color 0.18s var(--ease);
      }
      .btn-primary {
        background: var(--accent);
        color: var(--accent-ink);
      }
      .btn-primary:hover {
        transform: translateY(-2px);
      }
      .btn-primary:active {
        transform: scale(0.98);
      }
      .btn-ghost {
        background: transparent;
        color: var(--ink);
        border-color: var(--line);
      }
      .btn-ghost:hover {
        border-color: var(--ink);
        transform: translateY(-2px);
      }
      .btn-ghost:active {
        transform: scale(0.98);
      }
      .btn-sm {
        padding: 11px 18px;
        font-size: 15px;
      }
      .btn-block {
        width: 100%;
      }
      .btn[disabled] {
        opacity: 0.6;
        cursor: progress;
        transform: none;
      }

      @media (prefers-reduced-motion: reduce) {
        .btn {
          transition: none;
        }
        .btn:hover {
          transform: none;
        }
      }

      /* ---------- header ---------- */
      .site-head {
        position: sticky;
        top: 0;
        z-index: 20;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }
      .head-inner {
        height: 68px;
        display: flex;
        align-items: center;
        gap: 28px;
      }
      .wordmark {
        font-weight: 700;
        font-size: 20px;
        letter-spacing: -0.04em;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
      }
      .wordmark-art {
        display: block;
        width: 74px;
      }
      .wordmark-art svg {
        display: block;
        width: 100%;
        height: auto;
      }
      .head-nav {
        display: flex;
        gap: 22px;
        margin-left: auto;
        font-size: 16px;
      }
      .head-nav a {
        text-decoration: none;
        color: var(--ink-soft);
        transition: color 0.18s var(--ease);
      }
      .head-nav a:hover {
        color: var(--ink);
      }
      .lang-switch {
        font-size: 15px;
        font-weight: 500;
        color: var(--ink-soft);
        text-decoration: none;
        padding: 11px 4px;
        transition: color 0.18s var(--ease);
      }
      .lang-switch:hover {
        color: var(--ink);
      }

      .theme-toggle {
        font: inherit;
        font-size: 15px;
        font-weight: 500;
        line-height: 1;
        color: var(--ink-soft);
        background: transparent;
        border: 1px solid var(--line);
        border-radius: var(--r);
        padding: 11px 16px;
        cursor: pointer;
        transition:
          color 0.18s var(--ease),
          border-color 0.18s var(--ease);
      }
      .theme-toggle:hover {
        color: var(--ink);
        border-color: var(--ink-soft);
      }
      .theme-toggle:active {
        transform: scale(0.98);
      }
      @media (prefers-reduced-motion: reduce) {
        .theme-toggle {
          transition: none;
        }
        .theme-toggle:active {
          transform: none;
        }
      }

      /* Latvian nav labels are long. Below 1024 they would wrap to a second
         line, so the nav drops out and the CTA carries the header. */
      @media (max-width: 1023px) {
        .head-inner {
          gap: 8px;
        }
        .head-nav {
          display: none;
        }
        .lang-switch {
          margin-left: auto;
        }
        .theme-toggle {
